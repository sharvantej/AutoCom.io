{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Autocom",
  "version": "2.0.0-alpha",
  "identifier": "com.autoosc.app",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:5000",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Autocom",
        "width": 1280,
        "height": 720,
        "fullscreen": false,
        "resizable": true,
        "theme": "Dark",
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ws: wss: http: https:; object-src 'none'; base-uri 'self'; form-action 'self';"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/sharvantej/AutoCom.io/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBRUM2RDU5NzVFOEM1NTAKUldSUXhlaDFXVzNzK3RST1RtWk11K0hwamJDNDV5aDdXT0VlOUhRcldFNUhIWXpCenN2ZU5JSmIK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.sectigo.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Autocom",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "compression": "lzma",
        "installerIcon": "../public/autocom-title.ico",
        "headerImage": "icons/installer/nsis-header.bmp",
        "sidebarImage": "icons/installer/nsis-sidebar.bmp"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "signingIdentity": null
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": []
  }
}
