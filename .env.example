# Copy this file to .env and fill in real values. .env is gitignored and
# never leaves your machine — CI gets the same two values from GitHub
# Actions repo secrets instead (Settings → Secrets and variables → Actions).
#
# Only needed for local signed release builds (npm run build:*). Not
# required for `npm run dev` or any of the verification commands.
#
# Generate a keypair with: npx tauri signer generate -w <path>
# The PUBLIC half of the keypair goes in src-tauri/tauri.conf.json under
# plugins.updater.pubkey — the private half and its password go here.

TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
